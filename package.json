{
  "name": "dl-vizlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:gradcheck": "vitest run tests/gradcheck",
    "test:parity": "vitest run tests/parity",
    "test:determinism": "vitest run tests/determinism",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "measure": "tsx scripts/measure-memory.ts && tsx --tsconfig tsconfig.tsx.json scripts/measure-engine.ts && playwright test tests/e2e/perf.spec.ts tests/e2e/perf-cnn.spec.ts --project=chromium --workers=1",
    "figures": "tsx --tsconfig tsconfig.tsx.json scripts/gen-figures.ts",
    "report": "tsx scripts/gen-validation-report.ts && tsx --tsconfig tsconfig.tsx.json scripts/gen-trace-stats.ts && tsx scripts/gen-npm-spec.ts",
    "schema": "tsx scripts/gen-schema.ts",
    "samples": "tsx scripts/gen-sample-trace.ts",
    "slides": "npm run build && tsx --tsconfig tsconfig.tsx.json scripts/gen-slides.ts",
    "figures:batch": "tsx --tsconfig tsconfig.tsx.json scripts/export-figures.ts"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "katex": "^0.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
